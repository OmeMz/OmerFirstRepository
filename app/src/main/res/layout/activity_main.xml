<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9D9D9D"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/subjectname"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:text="@string/header"
        android:textColor="#BA1D1D"
        android:textSize="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/subjectphoto"
        android:layout_width="346dp"
        android:layout_height="241dp"
        android:layout_marginTop="8dp"
        android:paddingTop="60dp"
        android:src="@drawable/negev"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subjectname" />

    <Button
        android:id="@+id/mainButton"
        android:layout_width="150dp"
        android:layout_height="84dp"
        android:text="@string/mainButton"
        app:layout_constraintBottom_toTopOf="@+id/subjectdescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subjectphoto" />

    <TextView
        android:id="@+id/subjectdescription"
        android:layout_width="273dp"
        android:layout_height="120dp"
        android:layout_marginTop="50dp"
        android:text="@string/explanation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subjectphoto"
        app:layout_constraintVertical_bias="0.421" />
</androidx.constraintlayout.widget.ConstraintLayout>